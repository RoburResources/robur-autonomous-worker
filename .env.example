# ─────────────────────────────────────────────────────────────────────────────
# Robur Autonomous Worker — Environment Variables
# Copy this file to .env and fill in your values.
# On Manus WebDev, BUILT_IN_*, DATABASE_URL, JWT_SECRET, VITE_APP_ID,
# OAUTH_SERVER_URL, OWNER_OPEN_ID, and OWNER_NAME are injected automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Retell AI (Voice Agent) ──────────────────────────────────────────────────
# Get from: https://app.retellai.com/dashboard → API Keys
RETELL_API_KEY=key_your_retell_api_key_here

# Your Retell AI agent ID for outbound calls and briefings
# Get from: https://app.retellai.com/agents → select your agent → copy ID
RETELL_AGENT_ID=agent_your_agent_id_here

# ─── Twilio (SMS) ────────────────────────────────────────────────────────────
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio phone number (E.164 format, e.g. +15550001234)
TWILIO_PHONE_NUMBER=+15550001234

# ─── Owner Contact ───────────────────────────────────────────────────────────
# The owner's phone number for briefing calls, approval requests, and alerts
USER_PHONE=+15550005678

# ─── Manus Platform (auto-injected on Manus WebDev — do not set manually) ───
# DATABASE_URL=mysql://...
# JWT_SECRET=...
# BUILT_IN_FORGE_API_URL=https://...
# BUILT_IN_FORGE_API_KEY=...
# VITE_APP_ID=...
# OAUTH_SERVER_URL=https://...
# OWNER_OPEN_ID=...
# OWNER_NAME=...

# ─── Optional: Email Sending (Improvement #1) ────────────────────────────────
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# FROM_EMAIL=noreply@yourdomain.com
# FROM_NAME=Your Business Name

# ─── Optional: Mem0 Shared Brain (Improvement #2) ────────────────────────────
# MEM0_API_KEY=m0-your_mem0_api_key_here

# ─── Optional: Web Search (Improvement #3) ───────────────────────────────────
# SERPER_API_KEY=your_serper_api_key_here
